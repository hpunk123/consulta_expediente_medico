<script>
  const id_eval = {{id_eval}};
  const tatuajesDetalle = {{{json tatuajesDetalle}}};
  const observaciones = {{{json observaciones}}};
  const isFinalizado = {{#if finalizado}}true{{else}}false{{/if}};
  let activeTooltip = null;

  // Deshabilitar edición si el expediente está finalizado
  function disableEditingIfFinalized() {
    if (!isFinalizado) return;

    // Ocultar todos los botones de guardar
    document.querySelectorAll('.btn-primary').forEach(btn => {
      if (btn.textContent.includes('Guardar') || btn.textContent.includes('Subir')) {
        btn.style.display = 'none';
      }
    });

    // Deshabilitar todos los inputs, selects y textareas (excepto los del modal SICOC)
    document.querySelectorAll('.form-input, input[type="text"], input[type="number"], input[type="date"], input[type="tel"], input[type="file"], select, textarea').forEach(el => {
      // No deshabilitar si está dentro del modal SICOC
      if (el.closest('#sicocModal')) return;
      el.disabled = true;
      el.style.opacity = '0.6';
      el.style.cursor = 'not-allowed';
    });

    // Deshabilitar contenteditable
    document.querySelectorAll('[contenteditable="true"]').forEach(el => {
      el.contentEditable = 'false';
      el.style.opacity = '0.6';
      el.style.cursor = 'not-allowed';
    });

    // Deshabilitar checkboxes
    document.querySelectorAll('input[type="checkbox"]').forEach(el => {
      el.disabled = true;
      el.style.opacity = '0.6';
      el.style.cursor = 'not-allowed';
    });

    // ===== TATUAJES =====
    // Ocultar botones de acción en tatuajes
    document.querySelectorAll('.btn-ghost[onclick*="editTatuaje"], .btn-ghost[onclick*="deleteTatuaje"]').forEach(btn => {
      btn.style.display = 'none';
    });

    // Ocultar botón de agregar tatuaje
    document.querySelectorAll('button[onclick="openTatuajeModal()"]').forEach(btn => {
      btn.style.display = 'none';
    });

    // Deshabilitar zonas SVG del mapa corporal
    document.querySelectorAll('.body-zone').forEach(zone => {
      zone.style.cursor = 'not-allowed';
      zone.style.pointerEvents = 'none';
    });

    // Ocultar toolbar de editores rich text
    document.querySelectorAll('.obs-toolbar').forEach(toolbar => {
      toolbar.style.display = 'none';
    });

    // ===== DOCUMENTACIÓN =====
    // Ocultar sección de upload de documentos
    const uploadSection = document.getElementById('upload-section');
    if (uploadSection) {
      uploadSection.style.display = 'none';
    }

    // Ocultar botones de eliminar y reemplazar documentos
    document.querySelectorAll('.btn-danger[onclick*="eliminarDocumento"], .btn-secondary[onclick*="mostrarFormularioUpload"]').forEach(btn => {
      btn.style.display = 'none';
    });
  }

  // Calcular edad a partir de fecha de nacimiento
  function calcularEdad() {
    const fechaInput = document.getElementById('dg_fecha_nacimiento').value;
    const edadInput = document.getElementById('dg_edad');
    if (!fechaInput) {
      edadInput.value = '';
      return;
    }
    const nacimiento = new Date(fechaInput + 'T00:00:00');
    const hoy = new Date();
    let edad = hoy.getFullYear() - nacimiento.getFullYear();
    const mes = hoy.getMonth() - nacimiento.getMonth();
    if (mes < 0 || (mes === 0 && hoy.getDate() < nacimiento.getDate())) {
      edad--;
    }
    edadInput.value = edad >= 0 ? edad : '';
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Calcular edad si ya hay fecha de nacimiento
    calcularEdad();

    // Tabs
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const tabId = this.getAttribute('data-tab');
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));
        this.classList.add('active');
        document.getElementById('tab-' + tabId).classList.add('active');
        // Guardar tab activo en URL
        const url = new URL(window.location);
        url.searchParams.set('tab', tabId);
        window.history.replaceState({}, '', url);
      });
    });

    // Activar tab desde URL
    const urlParams = new URLSearchParams(window.location.search);
    const activeTab = urlParams.get('tab');
    if (activeTab) {
      const tabBtn = document.querySelector(`[data-tab="${activeTab}"]`);
      const tabPanel = document.getElementById('tab-' + activeTab);
      if (tabBtn && tabPanel) {
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));
        tabBtn.classList.add('active');
        tabPanel.classList.add('active');
      }
    }

    // Cargar observaciones en editores
    loadObservaciones();

    // Cargar exploración física
    loadExploracionFisica();

    // Cargar somatometría
    loadSomatometria();

    // Inicializar mapa corporal
    initBodyMap();
    markTattooZones();

    // Deshabilitar edición si está finalizado
    disableEditingIfFinalized();

    // Verificar si se necesita mostrar modal SICOC
    checkSicocModal();
  });

  // Mostrar modal SICOC si no tiene número de evaluación
  function checkSicocModal() {
    const tieneConsecutivo = {{#if enlaceSicoc.evalConsecutivo}}true{{else}}false{{/if}};
    if (!tieneConsecutivo) {
      document.getElementById('sicocModal').style.display = 'flex';
    }
  }

  // Variables globales para SICOC
  let datosSicocEncontrados = null;

  // Verificar evaluación en SICOC
  async function verificarSicoc() {
    const input = document.getElementById('sicoc_eval_consecutivo');
    const valor = input.value.trim();
    const errorDiv = document.getElementById('sicocError');
    const btnVerificar = document.getElementById('btnVerificarSicoc');
    
    // Limpiar errores previos
    errorDiv.style.display = 'none';
    input.style.borderColor = '';
    
    if (!valor) {
      input.style.borderColor = 'var(--red-500)';
      errorDiv.textContent = 'Ingrese un número de evaluación';
      errorDiv.style.display = 'block';
      input.focus();
      return;
    }

    // Deshabilitar botón mientras se consulta
    btnVerificar.disabled = true;
    btnVerificar.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verificando...';

    try {
      const response = await fetch(`/consulta/sicoc/verificar/${valor}`);
      const data = await response.json();

      if (data.success && data.data) {
        datosSicocEncontrados = data.data;
        
        // Llenar datos en el paso 2
        document.getElementById('sicocNombre').textContent = data.data.empNombreCompleto || '-';
        document.getElementById('sicocNumEmpleado').textContent = data.data.evalNumEmpleado || '-';
        document.getElementById('sicocConsecutivo').textContent = data.data.evalConsecutivo || '-';
        document.getElementById('sicocSubprograma').textContent = data.data.spgClave || '-';
        document.getElementById('sicocAdscripcion').textContent = data.data.evalAdscripcion || '-';
        document.getElementById('sicocCargo').textContent = data.data.cgCargo || '-';
        
        // Mostrar paso 2
        document.getElementById('sicocStep1').style.display = 'none';
        document.getElementById('sicocStep2').style.display = 'block';
      } else {
        errorDiv.textContent = data.message || 'No se encontró la evaluación en SICOC';
        errorDiv.style.display = 'block';
        input.style.borderColor = 'var(--red-500)';
      }
    } catch (error) {
      console.error('Error:', error);
      errorDiv.textContent = 'Error al conectar con SICOC';
      errorDiv.style.display = 'block';
    } finally {
      btnVerificar.disabled = false;
      btnVerificar.innerHTML = '<i class="fas fa-search"></i> Verificar';
    }
  }

  // Resetear modal SICOC al paso 1
  function resetSicocModal() {
    document.getElementById('sicocStep1').style.display = 'block';
    document.getElementById('sicocStep2').style.display = 'none';
    document.getElementById('sicocStep3').style.display = 'none';
    document.getElementById('sicocError').style.display = 'none';
    document.getElementById('sicoc_eval_consecutivo').style.borderColor = '';
    datosSicocEncontrados = null;
  }

  // Confirmar enlace a SICOC
  async function confirmarEnlaceSicoc() {
    const btnConfirmar = document.getElementById('btnConfirmarSicoc');
    btnConfirmar.disabled = true;
    btnConfirmar.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enlazando...';

    try {
      const valor = document.getElementById('sicoc_eval_consecutivo').value.trim();
      const response = await fetch(`/consulta/expediente/${id_eval}/enlazar-sicoc`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ evalConsecutivo: valor })
      });
      
      const data = await response.json();

      if (data.success) {
        // Actualizar campo en la vista
        document.getElementById('eval_consecutivo_display').value = valor;
        
        // Mostrar paso 3 (éxito)
        document.getElementById('sicocStep2').style.display = 'none';
        document.getElementById('sicocStep3').style.display = 'block';
      } else {
        alert('Error: ' + (data.message || 'No se pudo enlazar la evaluación'));
        btnConfirmar.disabled = false;
        btnConfirmar.innerHTML = '<i class="fas fa-link"></i> Confirmar Enlace';
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error al enlazar la evaluación');
      btnConfirmar.disabled = false;
      btnConfirmar.innerHTML = '<i class="fas fa-link"></i> Confirmar Enlace';
    }
  }

  // Cerrar modal SICOC y recargar página
  function closeSicocModal() {
    document.getElementById('sicocModal').style.display = 'none';
    resetSicocModal();
    // Recargar la página para obtener los datos actualizados
    window.location.reload();
  }

  // Permitir Enter en el input de SICOC y prevenir cierre del modal
  document.addEventListener('DOMContentLoaded', function() {
    const sicocInput = document.getElementById('sicoc_eval_consecutivo');
    if (sicocInput) {
      sicocInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          verificarSicoc();
        }
      });
    }

    // Prevenir cierre del modal SICOC al hacer clic fuera
    const sicocModal = document.getElementById('sicocModal');
    if (sicocModal) {
      sicocModal.addEventListener('click', function(e) {
        // Solo permitir clic en el contenido del modal, no en el backdrop
        if (e.target === sicocModal) {
          e.stopPropagation();
        }
      });
    }
  });

  // Inicializar eventos en las zonas del SVG
  function initBodyMap() {
    document.querySelectorAll('.body-zone').forEach(zone => {
      zone.addEventListener('click', function(e) {
        e.stopPropagation();
        const zoneName = this.dataset.zone;
        const zoneLabel = this.dataset.label;
        showTattooTooltip(this, zoneName, zoneLabel);
      });
    });

    // Cerrar tooltip al hacer clic fuera
    document.addEventListener('click', function(e) {
      if (activeTooltip && 
          !activeTooltip.contains(e.target) && 
          !e.target.classList.contains('body-zone') &&
          !e.target.closest('.tattoo-tooltip-form')) {
        closeActiveTooltip();
      }
    });
  }

  // Cerrar tooltip activo
  function closeActiveTooltip() {
    if (activeTooltip) {
      activeTooltip.remove();
      activeTooltip = null;
    }
  }

  // Mostrar tooltip de captura cerca de la zona seleccionada
  function showTattooTooltip(zoneElement, zoneName, zoneLabel) {
    closeActiveTooltip();
    
    const mapContainer = zoneElement.closest('.map-card-body');
    const containerRect = mapContainer.getBoundingClientRect();
    const zoneRect = zoneElement.getBoundingClientRect();
    
    const tooltipWidth = 300;
    const tooltipHeight = 450;
    const margin = 15;
    
    const zoneCenterY = zoneRect.top - containerRect.top + zoneRect.height / 2;
    const zoneCenterX = zoneRect.left - containerRect.left + zoneRect.width / 2;
    
    let top, left;
    let rightSpace = containerRect.right - zoneRect.right;
    let leftSpace = zoneRect.left - containerRect.left;
    
    // Posicionar a la derecha si hay espacio
    if (rightSpace >= tooltipWidth + margin) {
      left = (zoneRect.right - containerRect.left) + margin;
      top = zoneCenterY - tooltipHeight / 2;
    } else if (leftSpace >= tooltipWidth + margin) {
      left = (zoneRect.left - containerRect.left) - tooltipWidth - margin;
      top = zoneCenterY - tooltipHeight / 2;
    } else {
      left = zoneCenterX - tooltipWidth / 2;
      let bottomSpace = containerRect.bottom - zoneRect.bottom;
      if (bottomSpace >= tooltipHeight + margin) {
        top = (zoneRect.bottom - containerRect.top) + margin;
      } else {
        top = (zoneRect.top - containerRect.top) - tooltipHeight - margin;
      }
    }
    
    // Asegurar que no se salga del contenedor
    const maxLeft = containerRect.width - tooltipWidth - 10;
    const maxTop = containerRect.height - tooltipHeight - 10;
    left = Math.max(10, Math.min(left, maxLeft));
    top = Math.max(10, Math.min(top, maxTop));
    
    // Verificar si ya existe un tatuaje en esta zona
    const existingTattoo = tatuajesDetalle.find(t => t.zona === zoneName);
    
    const tooltip = document.createElement('div');
    tooltip.className = 'tattoo-tooltip-form';
    tooltip.innerHTML = `
      <div class="tooltip-form-header">
        <span class="tooltip-zone-name"><i class="fas fa-map-marker-alt"></i> ${zoneLabel || zoneName}</span>
        <button type="button" class="tooltip-close" onclick="closeActiveTooltip()">&times;</button>
      </div>
      <div class="tooltip-form-body">
        <div class="tooltip-field">
          <label>Tamaño *</label>
          <select id="tooltip-tamano" class="tooltip-input">
            <option value="">Seleccionar</option>
            <option value="PEQUEÑO" ${existingTattoo?.tamano === 'PEQUEÑO' ? 'selected' : ''}>Pequeño (&lt;10cm)</option>
            <option value="MEDIANO" ${existingTattoo?.tamano === 'MEDIANO' ? 'selected' : ''}>Mediano (10-20cm)</option>
            <option value="GRANDE" ${existingTattoo?.tamano === 'GRANDE' ? 'selected' : ''}>Grande (20-40cm)</option>
            <option value="MUY_GRANDE" ${existingTattoo?.tamano === 'MUY_GRANDE' ? 'selected' : ''}>Muy grande (&gt;40cm)</option>
          </select>
        </div>
        <div class="tooltip-field">
          <label>Descripción *</label>
          <textarea id="tooltip-descripcion" class="tooltip-input" rows="2" placeholder="Diseño, colores, forma...">${existingTattoo?.descripcion || ''}</textarea>
        </div>
        <div class="tooltip-field">
          <label>Significado</label>
          <textarea id="tooltip-significado" class="tooltip-input" rows="2" placeholder="¿Qué significa para usted?">${existingTattoo?.significado || ''}</textarea>
        </div>
        <div class="tooltip-field-row">
          <div class="tooltip-field">
            <label>Costo</label>
            <div class="tooltip-input-prefix">
              <span>$</span>
              <input type="number" id="tooltip-costo" class="tooltip-input" placeholder="0.00" min="0" step="0.01" value="${existingTattoo?.costo || ''}">
            </div>
          </div>
          <div class="tooltip-field">
            <label>Año</label>
            <input type="number" id="tooltip-anio" class="tooltip-input" placeholder="2020" min="1950" max="2030" value="${existingTattoo?.anio || ''}">
          </div>
        </div>
      </div>
      <div class="tooltip-form-footer">
        ${existingTattoo ? `
          <button type="button" class="tooltip-btn-delete" onclick="deleteTattooFromTooltip(${existingTattoo.id_tatuaje_detalle})">
            <i class="fas fa-trash"></i> Eliminar
          </button>
        ` : ''}
        <button type="button" class="tooltip-btn-cancel" onclick="closeActiveTooltip()">Cancelar</button>
        <button type="button" class="tooltip-btn-save" onclick="saveTattooFromTooltip('${zoneName}')">
          <i class="fas fa-check"></i> ${existingTattoo ? 'Actualizar' : 'Guardar'}
        </button>
      </div>
    `;
    
    mapContainer.style.position = 'relative';
    mapContainer.appendChild(tooltip);
    tooltip.style.top = top + 'px';
    tooltip.style.left = left + 'px';
    activeTooltip = tooltip;
    setTimeout(() => tooltip.classList.add('show'), 10);
  }

  // Guardar tatuaje desde el tooltip
  async function saveTattooFromTooltip(zoneName) {
    const tamano = document.getElementById('tooltip-tamano').value;
    const descripcion = document.getElementById('tooltip-descripcion').value;
    const significado = document.getElementById('tooltip-significado').value;
    const costo = document.getElementById('tooltip-costo').value;
    const anio = document.getElementById('tooltip-anio').value;
    
    if (!tamano || !descripcion) {
      alert('Por favor llene los campos obligatorios: Tamaño y Descripción');
      return;
    }
    
    const existingTattoo = tatuajesDetalle.find(t => t.zona === zoneName);
    
    const body = {
      zona: zoneName,
      tamano,
      descripcion,
      significado,
      costo: costo || null,
      anio: anio || null
    };
    
    try {
      let url, method;
      
      if (existingTattoo) {
        url = `/consulta/tatuajes/${existingTattoo.id_tatuaje_detalle}`;
        method = 'PUT';
      } else {
        url = `/consulta/expediente/${id_eval}/tatuajes`;
        method = 'POST';
      }
      
      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      
      const data = await response.json();
      
      if (data.success) {
        window.location.href = `/consulta/expediente/${id_eval}?tab=tatuajes`;
      } else {
        alert(data.error || 'Error al guardar tatuaje');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error al guardar tatuaje');
    }
  }

