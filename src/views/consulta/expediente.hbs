            <span id="imc-icon" style="font-size:1.2rem;"></span>
            <div>
              <strong id="imc-category" style="font-size:var(--text-sm);"></strong>
              <p id="imc-description" style="font-size:var(--text-xs);color:var(--gray-600);margin:0;"></p>
            </div>
          </div>
        </div>

        <!-- Estado Nutricional -->
        <h3 class="section-title">ESTADO NUTRICIONAL</h3>
        <div style="margin-bottom:var(--sp-4);">
          <div class="obs-toolbar">
            <button type="button" class="obs-btn" onclick="execCmdEstadoNutricional('bold')" title="Negritas"><i class="fas fa-bold"></i></button>
            <button type="button" class="obs-btn" onclick="execCmdEstadoNutricional('underline')" title="Subrayar"><i class="fas fa-underline"></i></button>
            <button type="button" class="obs-btn" onclick="execCmdEstadoNutricional('insertUnorderedList')" title="Viñetas"><i class="fas fa-list-ul"></i></button>
            <button type="button" class="obs-btn" onclick="execCmdEstadoNutricional('insertOrderedList')" title="Lista numerada"><i class="fas fa-list-ol"></i></button>
          </div>
          <div class="obs-editor" contenteditable="true" id="soma_estado_nutricional" placeholder="Especifique el estado nutricional del evaluado..."></div>
        </div>

        <!-- Signos Vitales -->
