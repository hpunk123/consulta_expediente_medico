  // Guardar Exploración Física
  async function saveExploracionFisica() {
    const checks = document.querySelectorAll('.exploracion-check');
    const data = {};
    
    checks.forEach(cb => {
      data[cb.dataset.campo] = cb.checked ? 1 : 0;
    });

    // Obtener contenido de los editores
    const editores = ['cardiorespiratorio', 'endocrino', 'osteomuscular', 'neuropsiquiatrico', 'otros', 'sin_datos'];
    editores.forEach(campo => {
      const editor = document.getElementById('exp-' + campo);
      if (editor) {
        data[campo + '_obs'] = editor.innerHTML;
