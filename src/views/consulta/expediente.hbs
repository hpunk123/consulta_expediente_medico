  function previewPDF(input) {
    const file = input.files[0];
    if (file) {
      if (file.type !== 'application/pdf') {
        alert('Solo se permiten archivos PDF');
        input.value = '';
        return;
      }
      if (file.size > 2 * 1024 * 1024) {
        alert('El archivo no puede ser mayor a 2MB');
        input.value = '';
        return;
      }
      const url = URL.createObjectURL(file);
      document.getElementById('pdfEmbed').src = url;
      document.getElementById('pdfPreview').style.display = 'block';
    }
  }

  function removePreview() {
    document.getElementById('fileInput').value = '';
    document.getElementById('pdfPreview').style.display = 'none';
    document.getElementById('pdfEmbed').src = '';
  }

  async function subirDocumento() {
    const fileInput = document.getElementById('fileInput');
    const file = fileInput.files[0];
    
    if (!file) {
      alert('Debe seleccionar un archivo PDF');
      return;
    }

    const formData = new FormData();
    formData.append('file', file);
    
    const tipoDoc = document.querySelector('[name="tipo_documento"]');
    if (tipoDoc) {
      formData.append('tipo_documento', tipoDoc.value);
    }
    
    const observaciones = document.getElementById('docObservaciones');
    if (observaciones) {
      formData.append('observaciones', observaciones.value);
    }

    try {
      const response = await fetch(`/consulta/expediente/${id_eval}/documentos`, {
        method: 'POST',
        body: formData
      });

      const data = await response.json();
      if (data.success) {
        window.location.href = `/consulta/expediente/${id_eval}?tab=documentacion`;
      } else {
        alert(data.error || 'Error al subir documento');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error al subir documento');
    }
  }

