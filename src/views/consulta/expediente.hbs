  // Guardar todos los antecedentes
  async function saveAllAntecedentes() {
    const btn = document.getElementById('btnSaveAllAntecedentes');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';
    
    const secciones = [
      { name: 'Heredo Familiares', fn: () => saveHeredo(true) },
      { name: 'No Patológicos', fn: () => saveNoPat(true) },
      { name: 'Accidentes', fn: () => saveAccidentes(true) },
      { name: 'Patológicos', fn: () => savePatologicos(true) },
      { name: 'Salud Sexual', fn: () => saveSexual(true) },
      { name: 'Obs. Heredo', fn: () => saveObservacion('heredo', true) },
      { name: 'Obs. No Patológicos', fn: () => saveObservacion('nopat', true) },
      { name: 'Obs. Accidentes', fn: () => saveObservacion('accidentes', true) },
      { name: 'Obs. Patológicos', fn: () => saveObservacion('patologicos', true) },
      { name: 'Obs. Sexual', fn: () => saveObservacion('sexual', true) }
    ];
    
    const errores = [];
    
    for (const seccion of secciones) {
      try {
        const result = await seccion.fn();
        if (result && !result.success) {
          errores.push(seccion.name);
        }
      } catch (error) {
        console.error(`Error en ${seccion.name}:`, error);
        errores.push(seccion.name);
      }
    }
    
    if (errores.length > 0) {
      alert(`Error al guardar: ${errores.join(', ')}. Revise los datos e intente de nuevo.`);
    } else {
      showToast('Todos los antecedentes guardados correctamente');
    }
    
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-save"></i> Guardar Antecedentes';
  }

