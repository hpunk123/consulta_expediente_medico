          <input type="text" class="form-input" id="sexual_anticonceptivo_especifique" value="{{antecedentes.sexual.anticonceptivo_especifique}}" placeholder="Describa el método">
        </div>
        {{#if (eq datosGenerales.genero "MUJER")}}
        <div class="info-item">
          <div class="info-label">Última Menstruación</div>
          <input type="date" class="form-input" id="sexual_ultima_menstruacion" value="{{antecedentes.sexual.ultima_menstruacion}}">
        </div>
        <div class="info-item">
          <div class="info-label">Frecuencia Menstrual</div>
          <input type="text" class="form-input" id="sexual_frecuencia_menstrual" value="{{antecedentes.sexual.frecuencia_menstrual}}" placeholder="Ej: Cada 15 días, cada 28 días">
        </div>
        <div class="info-item">
          <div class="info-label">Número de Partos</div>
          <input type="number" class="form-input" id="sexual_num_partos" value="{{antecedentes.sexual.num_partos}}" placeholder="Número">
        </div>
