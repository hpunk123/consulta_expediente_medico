            <option value="SI" {{#if (eq antecedentes.sexual.ets "SI")}}selected{{/if}}>Sí</option>
            <option value="NO" {{#if (eq antecedentes.sexual.ets "NO")}}selected{{/if}}>No</option>
          </select>
        </div>
        <div class="info-item ets-fields" style="{{#if (eq antecedentes.sexual.ets 'SI')}}display:block;{{else}}display:none;{{/if}}">
          <div class="info-label">Especifique ETS</div>
          <input type="text" class="form-input" id="sexual_ets_especifique" value="{{antecedentes.sexual.ets_especifique}}" placeholder="Describa la enfermedad">
        </div>
        <div class="info-item">
          <div class="info-label">Método Anticonceptivo</div>
          <select class="form-input" id="sexual_anticonceptivo" onchange="toggleAnticonceptivo(this)">
            <option value="">Seleccionar</option>
            <option value="SI" {{#if (eq antecedentes.sexual.anticonceptivo "SI")}}selected{{/if}}>Sí</option>
            <option value="NO" {{#if (eq antecedentes.sexual.anticonceptivo "NO")}}selected{{/if}}>No</option>
          </select>
        </div>
        <div class="info-item anticonceptivo-fields" style="{{#if (eq antecedentes.sexual.anticonceptivo 'SI')}}display:block;{{else}}display:none;{{/if}}">
