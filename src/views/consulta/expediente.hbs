      od_sin_correccion: document.getElementById('av_od_sin_correccion').value || null,
      od_con_correccion: document.getElementById('av_od_con_correccion').value || null,
      od_estenopeico: document.getElementById('av_od_estenopeico').value || null,
      oi_sin_correccion: document.getElementById('av_oi_sin_correccion').value || null,
      oi_con_correccion: document.getElementById('av_oi_con_correccion').value || null,
      oi_estenopeico: document.getElementById('av_oi_estenopeico').value || null,
      ishihara: document.getElementById('av_ishihara').value || null,
      ishihara_detalle: document.getElementById('av_ishihara_detalle').innerHTML || null,
      exploracion: document.getElementById('av_exploracion').innerHTML || null,
      sintesis_tecnica: document.getElementById('av_sintesis_tecnica').innerHTML || null,
      sintesis_resultado: document.getElementById('av_sintesis_resultado').value || null,
      loc: document.getElementById('av_loc').checked ? 1 : 0,
      loc_detalle: document.getElementById('av_loc_detalle').innerHTML || null,
      loc_resultado: document.getElementById('av_loc_resultado').value || null,
      loc_num_evaluacion: locChecked ? (locNumEvaluacion || null) : null
    };

    try {
      const response = await fetch(`/consulta/expediente/${id_eval}/somatometria`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        showToast('Somatometría guardada');
      } else {
        alert(result.error || 'Error al guardar');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Error al guardar');
    }
  }

  // Cargar datos de somatometría
  function loadSomatometria() {
    fetch(`/consulta/expediente/${id_eval}/somatometria`)
      .then(res => res.json())
      .then(data => {
        if (data && data.id_somatometria) {
          document.getElementById('soma_peso').value = data.peso || '';
          document.getElementById('soma_talla').value = data.talla || '';
          if (data.peso && data.talla) {
            calcularIMC();
          }
          // Cargar estado nutricional
          const estadoNutricionalEditor = document.getElementById('soma_estado_nutricional');
          if (estadoNutricionalEditor && data.estado_nutricional) {
            estadoNutricionalEditor.innerHTML = data.estado_nutricional;
          }
          // Cargar signos vitales
          document.getElementById('soma_presion_arterial').value = data.presion_arterial || '';
          document.getElementById('soma_frecuencia_cardiaca').value = data.frecuencia_cardiaca || '';
          document.getElementById('soma_frecuencia_respiratoria').value = data.frecuencia_respiratoria || '';
          // Cargar agudeza visual
          document.getElementById('av_od_sin_correccion').value = data.od_sin_correccion || '';
          document.getElementById('av_od_con_correccion').value = data.od_con_correccion || '';
          document.getElementById('av_od_estenopeico').value = data.od_estenopeico || '';
          document.getElementById('av_oi_sin_correccion').value = data.oi_sin_correccion || '';
          document.getElementById('av_oi_con_correccion').value = data.oi_con_correccion || '';
          document.getElementById('av_oi_estenopeico').value = data.oi_estenopeico || '';
          // Cargar ishihara
          document.getElementById('av_ishihara').value = data.ishihara || '';
          if (data.ishihara === 'POSITIVO') {
            document.getElementById('ishihara-detalle-group').style.display = 'block';
            document.getElementById('av_ishihara_detalle').innerHTML = data.ishihara_detalle || '';
          }
          // Cargar exploración, síntesis, LOC
          document.getElementById('av_exploracion').innerHTML = data.exploracion || '';
          document.getElementById('av_sintesis_tecnica').innerHTML = data.sintesis_tecnica || '';
          document.getElementById('av_sintesis_resultado').value = data.sintesis_resultado || '';
          if (data.loc) {
            document.getElementById('av_loc').checked = true;
            document.getElementById('loc-detalle-group').style.display = 'block';
            document.getElementById('av_loc_detalle').innerHTML = data.loc_detalle || '';
            document.getElementById('av_loc_resultado').value = data.loc_resultado || '';
            document.getElementById('av_loc_num_evaluacion').value = data.loc_num_evaluacion || '';
          }
        }
      })
      .catch(err => console.error('Error cargando somatometría:', err));
  }
</script>

