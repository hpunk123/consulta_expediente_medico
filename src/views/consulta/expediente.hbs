  // Guardar Heredo Familiares
  async function saveHeredo(silent = false) {
    const data = {};
    document.querySelectorAll('.heredo-checkbox').forEach(cb => {
      data[cb.dataset.field] = cb.checked ? 1 : 0;
    });
    data.enf_otros_detalle = document.getElementById('enf_otros_detalle').value;

    // Determinar si hay OTROS (alguno de los checkboxes marcados o texto en detalle)
    const tieneOtros = data.enf_otros_padre || data.enf_otros_madre || data.enf_otros_abuelos || (data.enf_otros_detalle && data.enf_otros_detalle.trim() !== '');
    data.enf_otros = tieneOtros ? 1 : 0;

    try {
      const response = await fetch(`/consulta/expediente/${id_eval}/antecedentes/heredo`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        if (!silent) showToast('Heredo familiares guardado');
        return { success: true };
      } else {
