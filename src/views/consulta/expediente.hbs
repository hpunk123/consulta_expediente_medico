        <div class="info-grid" style="margin-bottom:var(--sp-4);">
          <div class="info-item">
            <div class="info-label">Presión Arterial (mmHg)</div>
            <input type="text" class="form-input" id="soma_presion_arterial" placeholder="Ej: 120/80">
          </div>
          <div class="info-item">
            <div class="info-label">Frecuencia Cardíaca (L x min)</div>
            <input type="number" class="form-input" id="soma_frecuencia_cardiaca" min="0" max="300" placeholder="Ej: 80">
          </div>
          <div class="info-item">
            <div class="info-label">Frecuencia Respiratoria (R x min)</div>
            <input type="number" class="form-input" id="soma_frecuencia_respiratoria" min="0" max="100" placeholder="Ej: 18">
          </div>
        </div>

