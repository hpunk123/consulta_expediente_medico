<div style="max-width:1000px;margin:0 auto;">
  <!-- Header -->
  <div class="expediente-header">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--sp-4);">
      <div>
        <h1>Expediente Médico</h1>
        <p>{{evaluado.nombre}} &middot; {{evaluado.anioEval}} &middot; {{evaluado.tipo_eval_desc}} &middot; ID vLife: {{id_eval}}</p>
      </div>
      <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;">
        <a href="/consulta/expediente/{{id_eval}}/pdf" class="btn btn-pdf btn-sm">
          <i class="fas fa-file-pdf"></i> PDF
        </a>
        {{#unless finalizado}}
        {{#if (or (eq user.rol_nombre 'administrador') (eq user.rol_nombre 'director') (eq user.rol_nombre 'subdirector') (eq user.rol_nombre 'jefe_departamento') (eq user.rol_nombre 'supervisor'))}}
        <button type="button" class="btn btn-warning btn-sm" onclick="openFinalizarModal()">
          <i class="fas fa-lock"></i> Finalizar
        </button>
        {{/if}}
        {{else}}
        {{#if (or (eq user.rol_nombre 'administrador') (eq user.rol_nombre 'director') (eq user.rol_nombre 'subdirector') (eq user.rol_nombre 'jefe_departamento'))}}
        <form action="/consulta/expediente/{{id_eval}}/liberar" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('¿Está seguro de liberar este expediente para edición?')">
            <i class="fas fa-unlock"></i> Liberar
          </button>
        </form>
        {{/if}}
        {{/unless}}
        <a href="/consulta" class="btn btn-ghost btn-sm" style="color:white;">
          <i class="fas fa-arrow-left"></i> Volver
        </a>
      </div>
    </div>
    {{#if finalizado}}
    <div style="margin-top:var(--sp-3);display:inline-flex;align-items:center;gap:var(--sp-2);font-size:var(--text-xs);background:rgba(16,185,129,0.2);padding:var(--sp-2) var(--sp-3);border-radius:var(--radius-full);color:#6ee7b7;">
      <i class="fas fa-check-circle"></i> Finalizado: {{finalizado.fecha_finalizacion}} {{#if finalizado.usuario_finalizo}}por {{finalizado.usuario_finalizo}}{{/if}}
    </div>
    {{/if}}
  </div>

  <!-- Datos Generales -->
  <div class="card" style="border-radius:0 0 var(--radius-lg) var(--radius-lg);margin-bottom:var(--sp-5);">
    <div class="card-header">
      <i class="fas fa-user" style="color:var(--blue-600);"></i>
      <h2>Datos Generales</h2>
    </div>
    <div class="card-body">
      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">Número de evaluación</div>
          {{#if enlaceSicoc.evalConsecutivo}}
          <input type="text" class="form-input" value="{{enlaceSicoc.evalConsecutivo}}" readonly style="background:var(--gray-100);cursor:not-allowed;">
          {{else}}
          <input type="text" class="form-input" id="eval_consecutivo_display" value="" readonly style="background:var(--gray-100);cursor:not-allowed;" placeholder="No registrado">
          {{/if}}
        </div>
        {{#if datosSicoc}}
        <div class="info-item">
          <div class="info-label">Nombre (SICOC)</div>
          <input type="text" class="form-input" value="{{datosSicoc.empNombreCompleto}}" readonly style="background:var(--gray-100);cursor:not-allowed;">
        </div>
        <div class="info-item">
          <div class="info-label">No. Empleado (SICOC)</div>
          <input type="text" class="form-input" value="{{datosSicoc.evalNumEmpleado}}" readonly style="background:var(--gray-100);cursor:not-allowed;">
        </div>
        <div class="info-item">
          <div class="info-label">Subprograma</div>
          <input type="text" class="form-input" value="{{datosSicoc.spgClave}}" readonly style="background:var(--gray-100);cursor:not-allowed;">
        </div>
        <div class="info-item">
          <div class="info-label">Adscripción</div>
          <input type="text" class="form-input" value="{{datosSicoc.evalAdscripcion}}" readonly style="background:var(--gray-100);cursor:not-allowed;">
        </div>
        <div class="info-item">
          <div class="info-label">Cargo</div>
          <input type="text" class="form-input" value="{{datosSicoc.cgCargo}}" readonly style="background:var(--gray-100);cursor:not-allowed;">
        </div>
        {{/if}}
        <div class="info-item">
          <div class="info-label">RFC</div>
          <input type="text" class="form-input" id="dg_rfc" value="{{datosGenerales.rfc}}" placeholder="RFC">
        </div>
        <div class="info-item">
          <div class="info-label">Género</div>
          <select class="form-input" id="dg_genero">
            <option value="">Seleccionar</option>
            <option value="HOMBRE" {{#if (eq datosGenerales.genero "HOMBRE")}}selected{{/if}}>Hombre</option>
            <option value="MUJER" {{#if (eq datosGenerales.genero "MUJER")}}selected{{/if}}>Mujer</option>
            <option value="OTRO" {{#if (eq datosGenerales.genero "OTRO")}}selected{{/if}}>Otro</option>
          </select>
        </div>
        <div class="info-item">
          <div class="info-label">Edad</div>
          <input type="number" class="form-input" id="dg_edad" value="{{datosGenerales.edad}}" placeholder="Edad" readonly>
        </div>
        <div class="info-item">
          <div class="info-label">Fecha de Nacimiento</div>
          <input type="date" class="form-input" id="dg_fecha_nacimiento" value="{{datosGenerales.fecha_nacimiento}}" onchange="calcularEdad()">
        </div>
        <div class="info-item">
          <div class="info-label">Estado Civil</div>
          <select class="form-input" id="dg_estado_civil">
            <option value="">Seleccionar</option>
            {{#if datosGenerales.estado_civil}}
            <option value="{{datosGenerales.estado_civil}}" selected>{{datosGenerales.estado_civil}}</option>
            {{/if}}
            <option value="SOLTERO(A)">Soltero(a)</option>
            <option value="CASADO(A)">Casado(a)</option>
            <option value="DIVORCIADO(A)">Divorciado(a)</option>
            <option value="VIUDO(A)">Viudo(a)</option>
            <option value="UNION_LIBRE">Unión libre</option>
          </select>
        </div>
        <div class="info-item">
          <div class="info-label">Escolaridad</div>
          <select class="form-input" id="dg_escolaridad">
            <option value="">Seleccionar</option>
            {{#if datosGenerales.escolaridad}}
            <option value="{{datosGenerales.escolaridad}}" selected>{{datosGenerales.escolaridad}}</option>
            {{/if}}
            <option value="PRIMARIA">Primaria</option>
            <option value="SECUNDARIA">Secundaria</option>
            <option value="PREPARATORIA">Preparatoria</option>
            <option value="LICENCIATURA">Licenciatura</option>
            <option value="MAESTRIA">Maestría</option>
            <option value="DOCTORADO">Doctorado</option>
          </select>
        </div>
        <div class="info-item">
          <div class="info-label">Teléfono</div>
          <input type="tel" class="form-input" id="dg_telefono_celular" value="{{datosGenerales.telefono_celular}}" placeholder="Teléfono celular">
        </div>
      </div>
      <div style="text-align:right;margin-top:var(--sp-3);">
        <button type="button" class="btn btn-primary btn-sm" onclick="saveDatosGenerales()">
          <i class="fas fa-save"></i> Guardar Datos Generales
        </button>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="card" style="margin-bottom:var(--sp-5);">
    <div class="tabs-nav">
      <button class="tab-btn active" data-tab="antecedentes">
        <i class="fas fa-notes-medical"></i> Antecedentes
      </button>
      <button class="tab-btn" data-tab="tatuajes">
        <i class="fas fa-paint-brush"></i> Tatuajes
      </button>
      <button class="tab-btn" data-tab="documentacion">
        <i class="fas fa-file-alt"></i> Documentación
      </button>
      <button class="tab-btn" data-tab="exploracion">
        <i class="fas fa-stethoscope"></i> Exploración Física
      </button>
      <button class="tab-btn" data-tab="somatometria">
        <i class="fas fa-heartbeat"></i> Somatometría y Signos Vitales
      </button>
    </div>

    <!-- Tab: Antecedentes -->
    <div class="tab-panel active" id="tab-antecedentes">
      <h2 style="font-size:var(--text-xl);font-weight:700;color:var(--blue-700);margin-bottom:var(--sp-4);">Historia Clínica</h2>
      <h3 class="section-title">Heredo Familiares</h3>
      <div class="heredo-table">
        <table>
          <thead>
            <tr>
              <th>Enfermedad</th>
              <th>Padre</th>
              <th>Madre</th>
              <th>Abuelos</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="badge badge-danger">Hipertensión</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_hipertension_padre" {{#if antecedentes.heredo.enf_hipertension_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_hipertension_madre" {{#if antecedentes.heredo.enf_hipertension_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_hipertension_abuelos" {{#if antecedentes.heredo.enf_hipertension_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td><span class="badge badge-warning">Diabetes</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_diabetes_padre" {{#if antecedentes.heredo.enf_diabetes_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_diabetes_madre" {{#if antecedentes.heredo.enf_diabetes_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_diabetes_abuelos" {{#if antecedentes.heredo.enf_diabetes_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td><span class="badge badge-danger">Cardíacas</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_cardiacas_padre" {{#if antecedentes.heredo.enf_cardiacas_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_cardiacas_madre" {{#if antecedentes.heredo.enf_cardiacas_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_cardiacas_abuelos" {{#if antecedentes.heredo.enf_cardiacas_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td><span class="badge badge-info">Artritis</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_artritis_padre" {{#if antecedentes.heredo.enf_artritis_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_artritis_madre" {{#if antecedentes.heredo.enf_artritis_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_artritis_abuelos" {{#if antecedentes.heredo.enf_artritis_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td><span class="badge badge-info">Psiquiátricas</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_psiquiatricas_padre" {{#if antecedentes.heredo.enf_psiquiatricas_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_psiquiatricas_madre" {{#if antecedentes.heredo.enf_psiquiatricas_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_psiquiatricas_abuelos" {{#if antecedentes.heredo.enf_psiquiatricas_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td><span class="badge badge-info">Epilepsia</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_epilepsia_padre" {{#if antecedentes.heredo.enf_epilepsia_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_epilepsia_madre" {{#if antecedentes.heredo.enf_epilepsia_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_epilepsia_abuelos" {{#if antecedentes.heredo.enf_epilepsia_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td><span class="badge badge-info">Tiroideas</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_tiroideas_padre" {{#if antecedentes.heredo.enf_tiroideas_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_tiroideas_madre" {{#if antecedentes.heredo.enf_tiroideas_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_tiroideas_abuelos" {{#if antecedentes.heredo.enf_tiroideas_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td><span class="badge badge-danger">Cáncer</span></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_cancer_padre" {{#if antecedentes.heredo.enf_cancer_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_cancer_madre" {{#if antecedentes.heredo.enf_cancer_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_cancer_abuelos" {{#if antecedentes.heredo.enf_cancer_abuelos}}checked{{/if}}></td>
            </tr>
            <tr>
              <td>
                <span class="badge badge-info">OTROS</span>
                <input type="text" class="form-input-inline" id="enf_otros_detalle" value="{{antecedentes.heredo.enf_otros_detalle}}" placeholder="Especifique...">
              </td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_otros_padre" {{#if antecedentes.heredo.enf_otros_padre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_otros_madre" {{#if antecedentes.heredo.enf_otros_madre}}checked{{/if}}></td>
              <td><input type="checkbox" class="heredo-checkbox" data-field="enf_otros_abuelos" {{#if antecedentes.heredo.enf_otros_abuelos}}checked{{/if}}></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Observaciones Heredo Familiares -->
      <div class="obs-editor-container">
        <label class="obs-label">Observaciones Heredo Familiares</label>
        <div class="obs-toolbar">
          <button type="button" class="obs-btn" onclick="execCmd('bold')" title="Negritas"><i class="fas fa-bold"></i></button>
          <button type="button" class="obs-btn" onclick="execCmd('underline')" title="Subrayar"><i class="fas fa-underline"></i></button>
          <button type="button" class="obs-btn" onclick="execCmd('insertUnorderedList')" title="Viñetas"><i class="fas fa-list-ul"></i></button>
          <button type="button" class="obs-btn" onclick="execCmd('insertOrderedList')" title="Lista numerada"><i class="fas fa-list-ol"></i></button>
          <div class="obs-toolbar-spacer"></div>
          <button type="button" class="obs-btn obs-btn-save" onclick="saveObservacion('heredo')" title="Guardar"><i class="fas fa-save"></i></button>
        </div>
        <div class="obs-editor" contenteditable="true" id="obs-heredo" placeholder="Escriba observaciones sobre heredo familiares..."></div>
      </div>

      <h3 class="section-title">Personales No Patológicos</h3>
      <div class="info-grid" style="margin-bottom:var(--sp-5);">
        <div class="info-item">
          <div class="info-label">Tipo Domicilio</div>
          <select class="form-input" id="nopat_tipo_domicilio">
            <option value="">Seleccionar</option>
            <option value="CASA" {{#if (eq antecedentes.noPat.tipo_domicilio "CASA")}}selected{{/if}}>Casa</option>
            <option value="DEPARTAMENTO" {{#if (eq antecedentes.noPat.tipo_domicilio "DEPARTAMENTO")}}selected{{/if}}>Departamento</option>
          </select>
        </div>
        <div class="info-item">
          <div class="info-label">Cuenta con Servicios</div>
          <select class="form-input" id="nopat_cuenta_servicios" onchange="toggleServicios(this)">
            <option value="">Seleccionar</option>
            <option value="SI" {{#if (eq antecedentes.noPat.cuenta_servicios "SI")}}selected{{/if}}>Sí</option>
            <option value="NO" {{#if (eq antecedentes.noPat.cuenta_servicios "NO")}}selected{{/if}}>No</option>
          </select>
        </div>
        <div class="info-item" id="especifique-servicios" style="{{#if (eq antecedentes.noPat.cuenta_servicios 'NO')}}display:block;{{else}}display:none;{{/if}}">
          <div class="info-label">Especifique Servicios</div>
          <input type="text" class="form-input" id="nopat_especifique_servicios" value="{{antecedentes.noPat.especifique_servicios}}" placeholder="¿Cuáles servicios le faltan?">
        </div>
        <div class="info-item">
          <div class="info-label">Cambio de Ropa</div>
          <select class="form-input" id="nopat_cambio_ropa">
            <option value="">Seleccionar</option>
            <option value="SI" {{#if (eq antecedentes.noPat.cambio_ropa "SI")}}selected{{/if}}>Sí</option>
            <option value="NO" {{#if (eq antecedentes.noPat.cambio_ropa "NO")}}selected{{/if}}>No</option>
          </select>
        </div>
        <div class="info-item">
          <div class="info-label">Baño Diario</div>
          <select class="form-input" id="nopat_bano_diario">
            <option value="">Seleccionar</option>
            <option value="SI" {{#if (eq antecedentes.noPat.bano_diario "SI")}}selected{{/if}}>Sí</option>
            <option value="NO" {{#if (eq antecedentes.noPat.bano_diario "NO")}}selected{{/if}}>No</option>
          </select>
        </div>
        <div class="info-item">
          <div class="info-label">Ingesta de Agua</div>
          <select class="form-input" id="nopat_ingesta_agua">
            <option value="">Seleccionar</option>
            <option value="1LT" {{#if (eq antecedentes.noPat.ingesta_agua "1LT")}}selected{{/if}}>1 Lt</option>
            <option value="2LTS" {{#if (eq antecedentes.noPat.ingesta_agua "2LTS")}}selected{{/if}}>2 Lts</option>
            <option value="MAS_2LTS" {{#if (eq antecedentes.noPat.ingesta_agua "MAS_2LTS")}}selected{{/if}}>Más de 2 Lts</option>
            <option value="NINGUNO" {{#if (eq antecedentes.noPat.ingesta_agua "NINGUNO")}}selected{{/if}}>Ninguno</option>
          </select>
        </div>
        <div class="info-item">
          <div class="info-label">Actividad Física</div>
          <select class="form-input" id="nopat_actividad_fisica" onchange="toggleActividad(this)">
            <option value="">Seleccionar</option>
            <option value="SI" {{#if (eq antecedentes.noPat.actividad_fisica "SI")}}selected{{/if}}>Sí</option>
            <option value="NO" {{#if (eq antecedentes.noPat.actividad_fisica "NO")}}selected{{/if}}>No</option>
          </select>
        </div>
        <div class="info-item actividad-fields" style="{{#if (eq antecedentes.noPat.actividad_fisica 'SI')}}display:block;{{else}}display:none;{{/if}}">
          <div class="info-label">Veces por Semana</div>
          <input type="number" class="form-input" id="nopat_veces_semana" value="{{antecedentes.noPat.veces_semana}}" placeholder="Ej: 3">
        </div>
        <div class="info-item actividad-fields" style="{{#if (eq antecedentes.noPat.actividad_fisica 'SI')}}display:block;{{else}}display:none;{{/if}}">
          <div class="info-label">Tipo de Actividad</div>
          <input type="text" class="form-input" id="nopat_tipo_actividad" value="{{antecedentes.noPat.tipo_actividad}}" placeholder="Ej: Correr, nadar, gym">
        </div>
        <div class="info-item">
          <div class="info-label">Horas de Sueño</div>
          <input type="number" class="form-input" id="nopat_horas_sueno" min="0" max="24" value="{{antecedentes.noPat.horas_sueno}}" placeholder="Ej: 8">
        </div>
      </div>

      <!-- Observaciones No Patológicos -->
      <div class="obs-editor-container">
        <label class="obs-label">Observaciones Personales No Patológicos</label>
        <div class="obs-toolbar">
          <button type="button" class="obs-btn" onclick="execCmd('bold')" title="Negritas"><i class="fas fa-bold"></i></button>
          <button type="button" class="obs-btn" onclick="execCmd('underline')" title="Subrayar"><i class="fas fa-underline"></i></button>
          <button type="button" class="obs-btn" onclick="execCmd('insertUnorderedList')" title="Viñetas"><i class="fas fa-list-ul"></i></button>
          <button type="button" class="obs-btn" onclick="execCmd('insertOrderedList')" title="Lista numerada"><i class="fas fa-list-ol"></i></button>
          <div class="obs-toolbar-spacer"></div>
          <button type="button" class="obs-btn obs-btn-save" onclick="saveObservacion('nopat')" title="Guardar"><i class="fas fa-save"></i></button>
        </div>
        <div class="obs-editor" contenteditable="true" id="obs-nopat" placeholder="Escriba observaciones sobre personales no patológicos..."></div>
      </div>

      <h3 class="section-title">Accidentes Laborales</h3>
      <div class="info-grid" style="margin-bottom:var(--sp-5);">
        <div class="info-item">
          <div class="info-label">¿Ha tenido accidentes laborales?</div>
          <select class="form-input" id="accidente_laboral" onchange="toggleAccidente(this)">
            <option value="">Seleccionar</option>
            <option value="SI" {{#if (eq antecedentes.accidentes.accidente_laboral "SI")}}selected{{/if}}>Sí</option>
            <option value="NO" {{#if (eq antecedentes.accidentes.accidente_laboral "NO")}}selected{{/if}}>No</option>
          </select>
        </div>
        <div class="info-item accidente-fields" style="{{#if (eq antecedentes.accidentes.accidente_laboral 'SI')}}display:block;{{else}}display:none;{{/if}}">
          <div class="info-label">Año del Accidente</div>
          <input type="number" class="form-input" id="accidente_anio" value="{{antecedentes.accidentes.accidente_anio}}" placeholder="Ej: 2020">
        </div>
        <div class="info-item accidente-fields" style="{{#if (eq antecedentes.accidentes.accidente_laboral 'SI')}}display:block;{{else}}display:none;{{/if}}">
          <div class="info-label">Empresa</div>
          <input type="text" class="form-input" id="accidente_empresa" value="{{antecedentes.accidentes.accidente_empresa}}" placeholder="Nombre de la empresa">
        </div>
        <div class="info-item accidente-fields" style="grid-column: span 2;{{#if (eq antecedentes.accidentes.accidente_laboral 'SI')}}display:block;{{else}}display:none;{{/if}}">
          <div class="info-label">Especifique</div>
