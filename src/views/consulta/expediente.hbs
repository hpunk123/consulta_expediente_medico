    <!-- Tab: Somatometría y Signos Vitales -->
    <div class="tab-panel" id="tab-somatometria">
      <h3 class="section-title">SOMATOMETRÍA</h3>
      
      <div style="margin-bottom:var(--sp-4);">
        <p style="font-size:var(--text-sm);color:var(--gray-600);margin-bottom:var(--sp-4);">
          Capture los datos de somatometría del evaluado. El IMC se calculará automáticamente.
        </p>

        <div class="info-grid" style="margin-bottom:var(--sp-4);">
          <div class="info-item">
            <div class="info-label">Peso (kg)</div>
            <input type="number" class="form-input" id="soma_peso" step="0.01" min="0" max="300" placeholder="Ej: 75.5" oninput="calcularIMC()">
          </div>
          <div class="info-item">
            <div class="info-label">Talla (m)</div>
            <input type="number" class="form-input" id="soma_talla" step="0.01" min="0" max="2.5" placeholder="Ej: 1.75" oninput="calcularIMC()">
          </div>
          <div class="info-item">
            <div class="info-label">IMC (kg/m²)</div>
            <input type="text" class="form-input" id="soma_imc" readonly placeholder="Se calcula automáticamente" style="background:var(--gray-100);cursor:not-allowed;">
          </div>
        </div>

        <!-- Indicador de IMC -->
        <div id="imc-indicator" style="display:none;margin-bottom:var(--sp-4);padding:var(--sp-3);border-radius:var(--radius-md);">
