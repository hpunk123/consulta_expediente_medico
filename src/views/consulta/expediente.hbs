  // Somatometría - Calcular IMC
  function calcularIMC() {
    const peso = parseFloat(document.getElementById('soma_peso').value);
    const talla = parseFloat(document.getElementById('soma_talla').value);
    const imcInput = document.getElementById('soma_imc');
    const indicator = document.getElementById('imc-indicator');

    if (peso > 0 && talla > 0) {
      const imc = peso / (talla * talla);
      imcInput.value = imc.toFixed(2);
      
      // Mostrar indicador
      indicator.style.display = 'block';
      
      // Determinar categoría según matriz de clasificación
      let category, description, icon, color, bgColor;
      if (imc < 18.5) {
        category = 'Peso bajo';
        description = 'IMC menor a 18.5';
        icon = '⚠️';
        color = 'var(--warning)';
        bgColor = 'var(--yellow-50)';
      } else if (imc < 25) {
        category = 'Peso normal';
        description = 'IMC entre 18.5 y 24.99';
        icon = '✅';
        color = 'var(--success)';
        bgColor = 'var(--green-50)';
      } else if (imc < 30) {
        category = 'Sobrepeso';
        description = 'IMC entre 25 y 29.99';
        icon = '⚠️';
        color = 'var(--warning)';
        bgColor = 'var(--yellow-50)';
      } else if (imc < 35) {
        category = 'Obesidad grado I';
        description = 'IMC entre 30 y 34.99';
        icon = '🔴';
        color = 'var(--danger)';
        bgColor = 'var(--red-50)';
      } else if (imc < 40) {
        category = 'Obesidad grado II';
        description = 'IMC entre 35 y 39.99';
        icon = '🔴';
        color = 'var(--danger)';
        bgColor = 'var(--red-50)';
      } else {
        category = 'Obesidad grado III';
        description = 'IMC 40 o más';
        icon = '🔴';
        color = 'var(--danger)';
        bgColor = 'var(--red-50)';
      }

      document.getElementById('imc-icon').textContent = icon;
      document.getElementById('imc-category').textContent = category;
      document.getElementById('imc-category').style.color = color;
      document.getElementById('imc-description').textContent = description;
      indicator.style.background = bgColor;
      indicator.style.borderLeft = `4px solid ${color}`;
    } else {
      imcInput.value = '';
      indicator.style.display = 'none';
    }
  }

  // Guardar Somatometría
