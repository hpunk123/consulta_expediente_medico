<!-- Modal Finalizar Expediente -->
<div id="finalizarModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:500px;">
    <div class="modal-header">
      <h3><i class="fas fa-lock"></i> Finalizar Expediente</h3>
      <button type="button" class="modal-close" onclick="closeFinalizarModal()">&times;</button>
    </div>
    <form action="/consulta/expediente/{{id_eval}}/finalizar" method="POST">
      <div class="modal-body">
        <p style="margin-bottom:var(--sp-4);color:var(--gray-600);font-size:var(--text-sm);">
          Al finalizar el expediente no se podrán realizar más modificaciones. Seleccione el responsable.
        </p>
        <div class="form-group">
          <label>Responsable *</label>
          <select name="id_responsable" id="finalizar_responsable" required>
            <option value="">Seleccionar responsable</option>
            {{#each responsables}}
            <option value="{{this.id_usuario}}">{{this.nombre}} ({{this.clave}}) - {{this.rol_nombre}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeFinalizarModal()">Cancelar</button>
        <button type="submit" class="btn btn-warning">
          <i class="fas fa-lock"></i> Finalizar Expediente
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Ligar a SICOC -->
<div id="sicocModal" class="modal" style="display:none;">
  <div class="modal-content" style="max-width:500px;">
    <div class="modal-header">
      <h3><i class="fas fa-link"></i> Enlazar a SICOC</h3>
    </div>
    <div class="modal-body">
      <!-- Paso 1: Ingreso de número -->
      <div id="sicocStep1">
        <div style="text-align:center;margin-bottom:var(--sp-4);">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--blue-100);display:flex;align-items:center;justify-content:center;margin:0 auto var(--sp-3);">
            <i class="fas fa-exclamation-triangle" style="font-size:24px;color:var(--blue-600);"></i>
          </div>
          <p style="color:var(--gray-700);font-size:var(--text-sm);margin-bottom:var(--sp-2);">
            <strong>Este expediente no está enlazado a SICOC</strong>
          </p>
          <p style="color:var(--gray-500);font-size:var(--text-xs);">
            Ingrese el número de evaluación para verificar y enlazar
          </p>
        </div>
        <div class="form-group">
          <label for="sicoc_eval_consecutivo">Número de evaluación *</label>
          <div style="display:flex;gap:var(--sp-2);">
            <input type="text" id="sicoc_eval_consecutivo" class="form-input" placeholder="Ingrese el número" style="flex:1;" required>
            <button type="button" class="btn btn-primary" onclick="verificarSicoc()" id="btnVerificarSicoc">
              <i class="fas fa-search"></i> Verificar
            </button>
          </div>
          <div id="sicocError" style="display:none;color:var(--red-600);font-size:var(--text-xs);margin-top:4px;"></div>
        </div>
      </div>

      <!-- Paso 2: Confirmación de datos -->
      <div id="sicocStep2" style="display:none;">
        <div style="text-align:center;margin-bottom:var(--sp-4);">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--green-100);display:flex;align-items:center;justify-content:center;margin:0 auto var(--sp-3);">
            <i class="fas fa-check-circle" style="font-size:24px;color:var(--green-600);"></i>
          </div>
          <p style="color:var(--gray-700);font-size:var(--text-sm);margin-bottom:var(--sp-2);">
            <strong>Evaluación encontrada en SICOC</strong>
          </p>
          <p style="color:var(--gray-500);font-size:var(--text-xs);">
            Confirme que los datos corresponden al evaluado
          </p>
        </div>
        <div style="background:var(--surface);border-radius:var(--radius-md);padding:var(--sp-4);margin-bottom:var(--sp-4);">
          <div style="display:grid;gap:var(--sp-3);">
            <div>
              <div style="font-size:var(--text-xs);color:var(--text-secondary);margin-bottom:2px;">Nombre</div>
              <div style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);" id="sicocNombre">-</div>
            </div>
            <div>
              <div style="font-size:var(--text-xs);color:var(--text-secondary);margin-bottom:2px;">No. Empleado</div>
              <div style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);" id="sicocNumEmpleado">-</div>
            </div>
            <div>
              <div style="font-size:var(--text-xs);color:var(--text-secondary);margin-bottom:2px;">Consecutivo</div>
              <div style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);" id="sicocConsecutivo">-</div>
            </div>
            <div>
              <div style="font-size:var(--text-xs);color:var(--text-secondary);margin-bottom:2px;">Subprograma</div>
              <div style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);" id="sicocSubprograma">-</div>
            </div>
            <div>
              <div style="font-size:var(--text-xs);color:var(--text-secondary);margin-bottom:2px;">Adscripción</div>
              <div style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);" id="sicocAdscripcion">-</div>
            </div>
            <div>
              <div style="font-size:var(--text-xs);color:var(--text-secondary);margin-bottom:2px;">Cargo</div>
              <div style="font-size:var(--text-sm);font-weight:600;color:var(--text-primary);" id="sicocCargo">-</div>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:var(--sp-2);justify-content:flex-end;">
          <button type="button" class="btn btn-secondary" onclick="resetSicocModal()">
            <i class="fas fa-arrow-left"></i> Cambiar número
          </button>
          <button type="button" class="btn btn-success" onclick="confirmarEnlaceSicoc()" id="btnConfirmarSicoc">
            <i class="fas fa-link"></i> Confirmar Enlace
          </button>
        </div>
      </div>

      <!-- Paso 3: Éxito -->
      <div id="sicocStep3" style="display:none;">
        <div style="text-align:center;">
          <div style="width:60px;height:60px;border-radius:50%;background:var(--green-100);display:flex;align-items:center;justify-content:center;margin:0 auto var(--sp-3);">
            <i class="fas fa-check" style="font-size:24px;color:var(--green-600);"></i>
          </div>
          <p style="color:var(--gray-700);font-size:var(--text-sm);margin-bottom:var(--sp-2);">
            <strong>¡Enlace exitoso!</strong>
          </p>
          <p style="color:var(--gray-500);font-size:var(--text-xs);margin-bottom:var(--sp-4);">
            El expediente ha sido enlazado a SICOC correctamente
          </p>
          <button type="button" class="btn btn-primary" onclick="closeSicocModal()">
            <i class="fas fa-check"></i> Continuar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
