                  <i class="fas fa-edit"></i>
                </button>
                <button class="btn btn-ghost btn-sm" onclick="deleteTatuaje({{this.id_tatuaje_detalle}})" title="Eliminar" style="color:var(--danger);">
                  <i class="fas fa-trash"></i>
                </button>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{/if}}
      </div>
    </div>

    <!-- Tab: Documentación -->
    <div class="tab-panel" id="tab-documentacion">
      <div class="instruction-box" style="background:var(--blue-50);border:1px solid var(--blue-200);border-radius:var(--radius-md);padding:var(--sp-4);margin-bottom:var(--sp-4);">
        <p style="font-size:var(--text-sm);color:var(--blue-800);margin:0;">
          <i class="fas fa-info-circle" style="color:var(--blue-600);"></i>
          Adjunte el último resumen clínico, receta médica, formato RT-09 o dictamen con el que cuente sobre el o los padecimientos actuales del evaluado. Estos documentos serán verificados durante el proceso de evaluación.
        </p>
      </div>

      {{#if documentos.length}}
      <!-- Documento cargado -->
      <div class="documento-cargado-card" style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:var(--radius-md);padding:var(--sp-4);margin-bottom:var(--sp-4);">
        <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-3);">
          <div style="width:48px;height:48px;background:var(--red-100);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-file-pdf" style="color:var(--red-600);font-size:1.5rem;"></i>
          </div>
          <div style="flex:1;">
            <div style="font-weight:600;color:var(--gray-900);">
              {{#if documentos.[0].tipo_documento}}
                {{#if (eq documentos.[0].tipo_documento "RT-09")}}Formato RT-09
                {{else if (eq documentos.[0].tipo_documento "RESUMEN_CLINICO")}}Resumen Clínico
                {{else if (eq documentos.[0].tipo_documento "RECETA_MEDICA")}}Receta Médica
                {{else if (eq documentos.[0].tipo_documento "DICTAMEN")}}Dictamen Médico
                {{else}}{{documentos.[0].tipo_documento}}
                {{/if}}
              {{else}}Documento médico
              {{/if}}
            </div>
            <div style="font-size:var(--text-xs);color:var(--gray-500);">Cargado: {{documentos.[0].creado}}</div>
            {{#if documentos.[0].observaciones}}
            <div style="font-size:var(--text-sm);color:var(--gray-600);margin-top:var(--sp-1);">{{documentos.[0].observaciones}}</div>
            {{/if}}
          </div>
        </div>
        <div style="display:flex;gap:var(--sp-2);">
          <a href="/consulta/documento/{{documentos.[0].filename}}" target="_blank" class="btn btn-primary btn-sm">
            <i class="fas fa-eye"></i> Ver
          </a>
          <button type="button" class="btn btn-danger btn-sm" onclick="eliminarDocumento()">
            <i class="fas fa-trash-alt"></i> Eliminar
          </button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="mostrarFormularioUpload()">
            <i class="fas fa-sync-alt"></i> Reemplazar
          </button>
        </div>
      </div>
      {{/if}}

      <!-- Formulario de subida -->
      <div id="upload-section" style="{{#if documentos.length}}display:none;{{/if}}">
        <h3 style="font-size:var(--text-lg);font-weight:600;color:var(--gray-900);margin-bottom:var(--sp-3);">
          <i class="fas fa-cloud-upload-alt" style="color:var(--blue-600);"></i> Subir Documento
        </h3>
        <p style="font-size:var(--text-sm);color:var(--gray-500);margin-bottom:var(--sp-3);">Formato permitido: PDF (Max. 2MB)</p>

        <form id="form-documentos" enctype="multipart/form-data">
          {{#if (eq antecedentes.accidentes.formato_rt09 "SI")}}
          <div style="background:var(--blue-50);border:1px solid var(--blue-200);border-radius:var(--radius-md);padding:var(--sp-3);margin-bottom:var(--sp-3);">
            <p style="font-size:var(--text-sm);color:var(--blue-800);margin:0;">
              <i class="fas fa-info-circle" style="color:var(--blue-600);"></i>
              Indicaste que cuentas con <strong>Formato RT-09</strong>. Por favor, adjunta el documento.
            </p>
          </div>
          <input type="hidden" name="tipo_documento" value="RT-09">
          {{else}}
          <div style="background:var(--blue-50);border:1px solid var(--blue-200);border-radius:var(--radius-md);padding:var(--sp-3);margin-bottom:var(--sp-3);">
            <p style="font-size:var(--text-sm);color:var(--blue-800);margin:0;">
              <i class="fas fa-info-circle" style="color:var(--blue-600);"></i>
              Selecciona el tipo de documento que vas a cargar: Resumen Clínico, Receta Médica o Dictamen.
            </p>
          </div>
          <div class="form-group" style="margin-bottom:var(--sp-3);">
            <label class="form-label">Tipo de documento *</label>
            <select class="form-input" name="tipo_documento" id="tipoDocumento" required>
              <option value="">Seleccionar tipo de documento</option>
              <option value="RESUMEN_CLINICO">Resumen Clínico</option>
              <option value="RECETA_MEDICA">Receta Médica</option>
              <option value="DICTAMEN">Dictamen Médico</option>
            </select>
          </div>
          {{/if}}

          <div class="upload-zone" id="dropZone" style="border:2px dashed var(--gray-300);border-radius:var(--radius-md);padding:var(--sp-6);text-align:center;cursor:pointer;transition:all 0.2s;" onclick="document.getElementById('fileInput').click()">
            <div style="font-size:2rem;color:var(--gray-400);margin-bottom:var(--sp-2);">
              <i class="fas fa-cloud-upload-alt"></i>
            </div>
            <p style="font-size:var(--text-sm);color:var(--gray-600);margin-bottom:var(--sp-1);">Arrastra y suelta el archivo aquí</p>
            <p style="font-size:var(--text-xs);color:var(--gray-400);margin-bottom:var(--sp-2);">o</p>
            <button type="button" class="btn btn-secondary btn-sm">
              <i class="fas fa-folder-open"></i> Seleccionar Archivo
            </button>
            <input type="file" id="fileInput" name="file" accept=".pdf" style="display:none;" onchange="previewPDF(this)" required>
            <p style="font-size:var(--text-xs);color:var(--gray-400);margin-top:var(--sp-2);">PDF (Max. 2MB)</p>
          </div>

          <!-- Previsualización del PDF -->
          <div id="pdfPreview" style="display:none;margin-top:var(--sp-4);">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--sp-2);">
              <span style="font-weight:600;color:var(--gray-900);">Vista previa del documento</span>
              <button type="button" class="btn btn-ghost btn-sm" onclick="removePreview()">
                <i class="fas fa-times"></i>
              </button>
            </div>
            <div style="border:1px solid var(--gray-200);border-radius:var(--radius-md);overflow:hidden;">
              <embed id="pdfEmbed" type="application/pdf" width="100%" height="500px">
            </div>
            <div style="margin-top:var(--sp-3);">
              <div class="form-group" style="margin-bottom:var(--sp-3);">
                <label class="form-label">Observaciones</label>
                <textarea class="form-input" name="observaciones" id="docObservaciones" rows="2" placeholder="Ingrese observaciones sobre el documento..."></textarea>
              </div>
              <button type="button" class="btn btn-primary" onclick="subirDocumento()">
                <i class="fas fa-cloud-upload-alt"></i> Subir
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

