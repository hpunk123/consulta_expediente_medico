  // Cargar datos de exploración física
  function loadExploracionFisica() {
    fetch(`/consulta/expediente/${id_eval}/exploracion-fisica`)
      .then(res => res.json())
      .then(data => {
        if (data && data.id_exploracion_fisica) {
          // Marcar checkboxes
          const campos = ['cardiorespiratorio', 'endocrino', 'osteomuscular', 'neuropsiquiatrico', 'otros', 'sin_datos'];
          campos.forEach(campo => {
            const check = document.querySelector(`[data-campo="${campo}"]`);
            if (check && data[campo]) {
              check.checked = true;
              const group = document.getElementById('group-' + campo);
              if (group) {
                group.style.display = 'block';
              }
            }
          });

          // Cargar contenido de editores
          campos.forEach(campo => {
            const editor = document.getElementById('exp-' + campo);
            if (editor && data[campo + '_obs']) {
              editor.innerHTML = data[campo + '_obs'];
            }
          });

          // Cargar habitus exterior
          const habitusEditor = document.getElementById('exp-habitus_exterior');
          if (habitusEditor && data.habitus_exterior) {
            habitusEditor.innerHTML = data.habitus_exterior;
          }
        }
      })
      .catch(err => console.error('Error cargando exploración física:', err));
  }

