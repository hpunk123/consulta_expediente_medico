<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CECC SSC CDMX - Consulta Expediente Médico</title>
  <link rel="icon" type="image/png" href="/img/logo_cdmx_2026.png">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    // Apply theme before paint to prevent flash
    (function() {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body class="landing">
  <!-- Grid Background -->
  <div class="landing-grid-bg"></div>

  <!-- Navigation -->
  <nav class="landing-nav" id="landingNav">
    <div class="landing-nav-container">
      <a href="/" class="landing-logo">
        <div class="landing-logo-icon">
          <img src="/img/logo_cdmx_2026.png" alt="CDMX" style="width:100%;height:100%;object-fit:contain;">
        </div>
        <span>CECC SSC CDMX</span>
      </a>
      <div class="landing-nav-links">
        <a href="#caracteristicas" class="landing-nav-link">Características</a>
        <a href="#roles" class="landing-nav-link">Roles</a>
        <button class="theme-switch" id="themeSwitch" aria-label="Cambiar tema" title="Cambiar modo claro/oscuro">
          <div class="theme-switch-track">
            <i class="fas fa-sun theme-switch-icon" id="themeIconLight"></i>
            <i class="fas fa-moon theme-switch-icon" id="themeIconDark"></i>
            <div class="theme-switch-thumb"></div>
          </div>
        </button>
        <a href="/login" class="landing-btn landing-btn-primary">
          <i class="fas fa-sign-in-alt"></i>
          Iniciar Sesión
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="landing-hero">
    <div class="landing-hero-content">
      <div class="landing-hero-badge">
        <i class="fas fa-shield-halved"></i>
        Sistema Institucional
      </div>
      <h1>Consulta de <span>Expedientes Médicos</span></h1>
      <p>Sistema integral de gestión y consulta de expedientes médicos del Centro de Evaluación y Control de Confianza del SSC CDMX</p>
      <div class="landing-hero-actions">
        <a href="/login" class="landing-btn landing-btn-primary landing-btn-lg">
          <i class="fas fa-arrow-right"></i>
          Acceder al Sistema
        </a>
        <a href="#caracteristicas" class="landing-btn landing-btn-ghost">
          <i class="fas fa-info-circle"></i>
          Conocer Más
        </a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="landing-stats">
    <div class="landing-stats-container">
      <div class="landing-stat">
        <div class="landing-stat-value">100<span>%</span></div>
        <div class="landing-stat-label">Expedientes Digitalizados</div>
      </div>
      <div class="landing-stat">
        <div class="landing-stat-value">24/7</div>
        <div class="landing-stat-label">Disponibilidad del Sistema</div>
      </div>
      <div class="landing-stat">
        <div class="landing-stat-value">4</div>
        <div class="landing-stat-label">Niveles de Acceso</div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="landing-features" id="caracteristicas">
    <div class="landing-features-container">
      <div class="landing-section-header">
        <h2>Características del Sistema</h2>
        <p>Herramientas diseñadas para optimizar la gestión de expedientes médicos institucionales</p>
      </div>
      <div class="landing-features-grid">
        <div class="landing-feature">
          <div class="landing-feature-icon">
            <i class="fas fa-search"></i>
          </div>
          <h3>Búsqueda Avanzada</h3>
          <p>Consulta rápida de expedientes por nombre del evaluado con resultados instantáneos y filtrados</p>
        </div>
        <div class="landing-feature">
          <div class="landing-feature-icon">
            <i class="fas fa-file-medical"></i>
          </div>
          <h3>Expediente Completo</h3>
          <p>Visualización integral de datos generales, antecedentes médicos, tatuajes y documentación</p>
        </div>
        <div class="landing-feature">
          <div class="landing-feature-icon">
            <i class="fas fa-file-pdf"></i>
          </div>
          <h3>Generación de PDF</h3>
          <p>Descarga de expedientes en formato PDF con toda la información médica estructurada</p>
        </div>
        <div class="landing-feature">
          <div class="landing-feature-icon">
            <i class="fas fa-users-cog"></i>
          </div>
          <h3>Gestión de Usuarios</h3>
          <p>Administración de cuentas de usuario con diferentes niveles de permisos y accesos</p>
        </div>
        <div class="landing-feature">
          <div class="landing-feature-icon">
            <i class="fas fa-lock"></i>
          </div>
          <h3>Seguridad Robusta</h3>
          <p>Autenticación segura con cifrado de contraseñas y control de sesiones institucional</p>
        </div>
        <div class="landing-feature">
          <div class="landing-feature-icon">
            <i class="fas fa-database"></i>
          </div>
          <h3>Multi-Base de Datos</h3>
          <p>Integración con sistemas existentes: vlifedb, historia_clinica_db y base de autenticación</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Roles Section -->
  <section class="landing-roles" id="roles">
    <div class="landing-roles-container">
      <div class="landing-section-header">
        <h2>Niveles de Acceso</h2>
        <p>Sistema de permisos diseñado para proteger la información médica sensible</p>
      </div>
      <div class="landing-roles-grid">
        <div class="landing-role">
          <div class="landing-role-icon">
            <i class="fas fa-crown"></i>
          </div>
          <div>
            <h4>Administrador</h4>
            <p>Control total del sistema: gestión de usuarios, consulta de expedientes y generación de PDFs</p>
          </div>
        </div>
        <div class="landing-role">
          <div class="landing-role-icon">
            <i class="fas fa-user-tie"></i>
          </div>
          <div>
            <h4>Director</h4>
            <p>Acceso a consulta de expedientes y descarga de documentos en formato PDF</p>
          </div>
        </div>
        <div class="landing-role">
          <div class="landing-role-icon">
            <i class="fas fa-user-shield"></i>
          </div>
          <div>
            <h4>Supervisor</h4>
            <p>Supervisión de expedientes con capacidad de generación de reportes PDF</p>
          </div>
        </div>
        <div class="landing-role">
          <div class="landing-role-icon">
            <i class="fas fa-user"></i>
          </div>
          <div>
            <h4>Evaluador</h4>
            <p>Consulta de expedientes médicos para procesos de evaluación institucional</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="landing-cta">
    <div class="landing-cta-container">
      <h2>Accede al Sistema</h2>
      <p>Inicia sesión con tus credenciales institucionales para consultar expedientes médicos</p>
      <a href="/login" class="landing-btn landing-btn-primary">
        <i class="fas fa-sign-in-alt"></i>
        Iniciar Sesión
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="landing-footer">
    <p>CECC SSC CDMX &mdash; Centro de Evaluación y Control de Confianza &mdash; Secretaría de Seguridad Ciudadana</p>
  </footer>

  <script>
    // Navbar scroll effect
    const nav = document.getElementById('landingNav');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Intersection Observer for animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, observerOptions);

    document.querySelectorAll('.landing-feature, .landing-role, .landing-stat').forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
      el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(el);
    });

    // Theme Switch
    const STORAGE_KEY = 'theme';
    const DARK = 'dark';
    const LIGHT = 'light';

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      const iconLight = document.getElementById('themeIconLight');
      const iconDark = document.getElementById('themeIconDark');
      if (iconLight && iconDark) {
        if (theme === DARK) {
          iconLight.classList.remove('active');
          iconDark.classList.add('active');
        } else {
          iconLight.classList.add('active');
          iconDark.classList.remove('active');
        }
      }
      localStorage.setItem(STORAGE_KEY, theme);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || LIGHT;
      applyTheme(current === DARK ? LIGHT : DARK);
    }

    // Initialize theme icons
    const currentTheme = document.documentElement.getAttribute('data-theme') || LIGHT;
    applyTheme(currentTheme);

    // Bind switch
    const switchBtn = document.getElementById('themeSwitch');
    if (switchBtn) {
      switchBtn.addEventListener('click', toggleTheme);
    }
  </script>
</body>
</html>
