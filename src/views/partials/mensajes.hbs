{{#if success_msg}}
<div class="alert alert-success">
  <i class="fas fa-check-circle"></i> {{success_msg}}
</div>
{{/if}}

{{#if error_msg}}
<div class="alert alert-danger">
  <i class="fas fa-exclamation-circle"></i> {{error_msg}}
</div>
{{/if}}

{{#if error}}
<div class="alert alert-danger">
  <i class="fas fa-exclamation-circle"></i> {{error}}
</div>
{{/if}}
